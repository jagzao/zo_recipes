# KitchenEye Backend Configuration

# Environment
ENVIRONMENT=development

# JWT Secret (CHANGE THIS IN PRODUCTION!)
JWT_SECRET_KEY=changeme-please-use-a-secure-random-string-in-production

# Timezone
DEFAULT_TIMEZONE=America/Mexico_City

# Cloudflare bindings (configured in wrangler.toml)
# DB - D1 database binding
# CONFIG_KV - KV namespace for configuration
# IMAGES_R2 - R2 bucket for images
