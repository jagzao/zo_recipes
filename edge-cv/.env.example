# KitchenEye Edge CV Configuration

# API Configuration
API_BASE_URL=https://api.kitcheneye.com
CAMERA_ID=your-camera-id-here
CAMERA_TYPE=gas  # gas or fridge
DEVICE_ID=edge-001

# Camera Configuration
CAMERA_INDEX=0
CAPTURE_WIDTH=1280
CAPTURE_HEIGHT=720

# Gas Detection Configuration (only if CAMERA_TYPE=gas)
GAS_MARKER_X=640
GAS_MARKER_Y=360
GAS_MARKER_HEIGHT=500
GAS_RED_THRESHOLD=15
GAS_YELLOW_THRESHOLD=35

# Fridge Detection Configuration (only if CAMERA_TYPE=fridge)
FRIDGE_MODEL_PATH=./models/yolov5n.onnx
FRIDGE_CONFIDENCE_THRESHOLD=0.4
FRIDGE_NMS_THRESHOLD=0.5

# Schedule Configuration
GAS_SCHEDULE_TIME=05:00  # HH:MM format (local time)
FRIDGE_SCHEDULE_INTERVAL=4  # hours

# Storage Configuration
STORE_IMAGES_LOCALLY=false
LOCAL_IMAGE_PATH=./captures
SEND_THUMBNAILS=true

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=5  # seconds

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
